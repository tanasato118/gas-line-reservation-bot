/**
 * 営業日・営業時間判定ユーティリティ。
 * 日祝（定休日）判定、営業時間外判定、問い合わせ受付完了メッセージ生成を担当。
 *
 * 定休日: 日曜 + 日本の祝日
 * 営業時間: 9:00〜18:00（平日・土曜）
 *
 * 祝日は内閣府公表の祝日リストを2026-2028年まで保持。毎年1月に HOLIDAYS を更新する。
 * （CalendarApp を使わない理由：権限要求を増やさない／確実性／オフライン動作）
 */
const ShopHours = {
  // 日本の祝日（yyyy-MM-dd）。毎年1月に翌々年分まで更新。
  HOLIDAYS: {
    // 2026年
    '2026-01-01': '元日',
    '2026-01-12': '成人の日',
    '2026-02-11': '建国記念の日',
    '2026-02-23': '天皇誕生日',
    '2026-03-20': '春分の日',
    '2026-04-29': '昭和の日',
    '2026-05-03': '憲法記念日',
    '2026-05-04': 'みどりの日',
    '2026-05-05': 'こどもの日',
    '2026-05-06': '振替休日',
    '2026-07-20': '海の日',
    '2026-08-11': '山の日',
    '2026-09-21': '敬老の日',
    '2026-09-22': '国民の休日',
    '2026-09-23': '秋分の日',
    '2026-10-12': 'スポーツの日',
    '2026-11-03': '文化の日',
    '2026-11-23': '勤労感謝の日',
    // 2027年
    '2027-01-01': '元日',
    '2027-01-11': '成人の日',
    '2027-02-11': '建国記念の日',
    '2027-02-23': '天皇誕生日',
    '2027-03-21': '春分の日',
    '2027-03-22': '振替休日',
    '2027-04-29': '昭和の日',
    '2027-05-03': '憲法記念日',
    '2027-05-04': 'みどりの日',
    '2027-05-05': 'こどもの日',
    '2027-07-19': '海の日',
    '2027-08-11': '山の日',
    '2027-09-20': '敬老の日',
    '2027-09-23': '秋分の日',
    '2027-10-11': 'スポーツの日',
    '2027-11-03': '文化の日',
    '2027-11-23': '勤労感謝の日',
    // 2028年
    '2028-01-01': '元日',
    '2028-01-10': '成人の日',
    '2028-02-11': '建国記念の日',
    '2028-02-23': '天皇誕生日',
    '2028-03-20': '春分の日',
    '2028-04-29': '昭和の日',
    '2028-05-03': '憲法記念日',
    '2028-05-04': 'みどりの日',
    '2028-05-05': 'こどもの日',
    '2028-07-17': '海の日',
    '2028-08-11': '山の日',
    '2028-09-18': '敬老の日',
    '2028-09-22': '秋分の日',
    '2028-10-09': 'スポーツの日',
    '2028-11-03': '文化の日',
    '2028-11-23': '勤労感謝の日'
  },

  OPEN_HOUR: 9,
  CLOSE_HOUR: 18,

  /** yyyy-MM-dd 形式（JST）で日付文字列を返す */
  _formatDate: function(date) {
    return Utilities.formatDate(date, 'Asia/Tokyo', 'yyyy-MM-dd');
  },

  /** 指定日付が日曜か */
  isSunday: function(date) {
    date = date || new Date();
    return date.getDay() === 0;
  },

  /** 指定日付が日本の祝日か */
  isHoliday: function(date) {
    date = date || new Date();
    return !!this.HOLIDAYS[this._formatDate(date)];
  },

  /** 定休日（日曜または祝日）か */
  isClosedDay: function(date) {
    return this.isSunday(date) || this.isHoliday(date);
  },

  /** 営業時間外か（日祝は常に時間外扱い） */
  isAfterHours: function(date) {
    date = date || new Date();
    if (this.isClosedDay(date)) return true;
    const h = date.getHours();
    return h < this.OPEN_HOUR || h >= this.CLOSE_HOUR;
  },

  /**
   * 問い合わせ受付時の「いつ返信予定か」メッセージを返す。
   * 返信タイミングを受付時刻から動的に生成し、ユーザーに明確に伝える。
   *
   * @param {Date} [now] 基準時刻（省略時は現在時刻）
   * @return {string} 返信予定メッセージ
   */
  replyEtaMessage: function(now) {
    now = now || new Date();
    if (this.isClosedDay(now)) {
      return '本日は日祝休のため、日祝休明けに担当者よりご返信いたします。';
    }
    if (this.isAfterHours(now)) {
      return '本日の営業時間を過ぎたため、翌営業日にスタッフよりご連絡いたします。';
    }
    return '内容を確認のうえ、営業時間内にスタッフよりご連絡いたします。';
  }
};
