# Google Apps Script の Script Properties に設定する値のテンプレート。
# このファイルは参考資料です。実際の設定は GAS エディタの
# 「プロジェクト設定」→「スクリプトプロパティ」 で行います。

# === 必須 ===

# LINE Messaging API の Channel Secret（Webhook 署名検証用）
# 取得元: https://developers.line.biz/ → チャネル → Basic settings
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# LINE Messaging API の Channel Access Token（長期）
# 取得元: 同上 → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# データ保存用 Google スプレッドシートの ID
# スプレッドシート URL https://docs.google.com/spreadsheets/d/<ID>/edit の <ID> 部分
SPREADSHEET_ID=your_spreadsheet_id_here

# === 任意 ===

# スタッフへのアラート Push 通知先 LINE User ID
# （新規予約・修理相談などでスタッフに通知したい場合のみ設定）
STAFF_LINE_USER_ID=your_staff_line_user_id_here

# プライバシーポリシーページの URL（GAS から参照される）
PRIVACY_POLICY_URL=https://example.com/privacy-policy

# Push 通知枠アラートの送信先メールアドレス
ALERT_EMAIL=alerts@example.com
